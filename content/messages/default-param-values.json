  "s1.p1": {
    "ru": "![ico-20 require] В ES6 появилась возможность указывать в сигнатуре функции значения параметров по умолчанию:",
    "eng": "",
    "ua": ""
  },
  "s1.p2": {
    "ru": "^^При вызове функции без аргументов:^^",
    "eng": "",
    "ua": ""
  },
  "s1.p3": {
    "ru": "^^возвращаемое значение будет ⟦f0⟧^^",
    "eng": "",
    "ua": ""
  },
  "s1.p4": {
    "ru": "^^При вызове функции с одним аргументом^^",
    "eng": "",
    "ua": ""
  },
  "s1.p5": {
    "ru": "^^возвращаемое значение будет ⟦f1⟧^^",
    "eng": "",
    "ua": ""
  },
  "s1.p6": {
    "ru": "^^При вызове функции с двумя аргументами^^",
    "eng": "",
    "ua": ""
  },
  "s1.p7": {
    "ru": "^^возвращаемое значение будет ⟦f2⟧^^",
    "eng": "",
    "ua": ""
  },
  "s1.p8": {
    "ru": "^^При вызове функции:^^",
    "eng": "",
    "ua": ""
  },
  "s1.p9": {
    "ru": "^^возвращаемое значение будет ⟦f3⟧^^",
    "eng": "",
    "ua": ""
  },
  "s1.p10": {
    "ru": "^^т.е. если аргумент не был передан при вызове функции, или передано значение ⟦f4⟧ (что, по сути, одно и то же), то будет использовано значение по умолчанию^^",
    "eng": "",
    "ua": ""
  },
