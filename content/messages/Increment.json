{
  "p1": {
    "ru": "Инкремент",
    "eng": "",
    "ua": ""
  },
  "p2": {
    "ru": "Инкремент - это увеличение значения числовой переменной на единицу",
    "eng": "",
    "ua": ""
  },
  "p3": {
    "ru": "Пост-префиксная форма:   **⟦f0⟧**",
    "eng": "",
    "ua": ""
  },
  "p4": {
    "ru": "Префиксная форма:        **⟦f1⟧**",
    "eng": "",
    "ua": ""
  },
  "p5": {
    "ru": "Пост-префиксная форма означает, что переменная будет увеличена после операции, в которой она принимает участие",
    "eng": "",
    "ua": ""
  },
  "p6": {
    "ru": "^^После операции:^^",
    "eng": "",
    "ua": ""
  },
  "p7": {
    "ru": "^^значение переменной ** z** будет ⟦f2⟧,^^",
    "eng": "",
    "ua": ""
  },
  "p8": {
    "ru": "^^а значение переменной ** x** станет равным ⟦f3⟧^^",
    "eng": "",
    "ua": ""
  },
  "p9": {
    "ru": "^^А вот после такой операции:^^",
    "eng": "",
    "ua": ""
  },
  "p10": {
    "ru": "^^сначала значение переменной ** x** станет ⟦f4⟧,^^",
    "eng": "",
    "ua": ""
  },
  "p11": {
    "ru": "^^а затем будет вычислено значение переменной ** z**:  ⟦f5⟧^^",
    "eng": "",
    "ua": ""
  },
  "p12": {
    "ru": "Декремент",
    "eng": "",
    "ua": ""
  },
  "p13": {
    "ru": "Все то же самое, только значение не увеличивается на 1, а уменьшается ![ico-25 smile]",
    "eng": "",
    "ua": ""
  },
  "p14": {
    "ru": "^^сначала значение переменной ** y** станет ⟦f6⟧,^^",
    "eng": "",
    "ua": ""
  },
  "p15": {
    "ru": "^^значение переменной ** x** станет ⟦f4⟧,^^",
    "eng": "",
    "ua": ""
  },
  "p16": {
    "ru": "^^а затем будет вычислено значение переменной ** z**:  ⟦f7⟧^^",
    "eng": "",
    "ua": ""
  }
}
